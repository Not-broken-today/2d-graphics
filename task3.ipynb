   "source": [
    "def butterworth_lowpass_filter(shape, cutoff, order):\n",
    "    \"\"\"\n",
    "    Создает низкочастотный фильтр Баттерворта.\n",
    "    \"\"\"\n",
    "    rows, cols = shape\n",
    "    crow, ccol = rows // 2, cols // 2\n",
    "\n",
    "    u = np.arange(rows)\n",
    "    v = np.arange(cols)\n",
    "    U, V = np.meshgrid(u, v, indexing='ij')\n",
    "\n",
    "    D = np.sqrt((U - crow)**2 + (V - ccol)**2)\n",
    "    \n",
    "    H = 1 / (1 + (D / cutoff)**(2 * order))\n",
    "    \n",
    "    return H\n",
    "\n",
    "\n",
    "def butterworth_highpass_filter(shape, cutoff, order):\n",
    "    \"\"\"\n",
    "    Создает высокочастотный фильтр Баттерворта.\n",
    "    \"\"\"\n",
    "    rows, cols = shape\n",
    "    crow, ccol = rows // 2, cols // 2\n",
    "\n",
    "    u = np.arange(rows)\n",
    "    v = np.arange(cols)\n",
    "    U, V = np.meshgrid(u, v, indexing='ij')\n",
    "\n",
    "    D = np.sqrt((U - crow)**2 + (V - ccol)**2)\n",
    "\n",
    "    D_safe = np.where(D == 0, 1e-10, D)\n",
    "    H = 1 / (1 + (cutoff / D_safe)**(2 * order))\n",
    "    \n",
    "    return H\n",
    "\n",
    "\n",
    "def apply_butterworth_filter(image, cutoff, order, filter_type='lowpass'):\n",
    "    \"\"\"\n",
    "    Применяет фильтр Баттерворта к изображению в частотной области.\n",
    "    \"\"\"\n",
    "    if len(image.shape) == 3:\n",
    "        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
    "    else:\n",
    "        gray = image.copy()\n",
    "    \n",
    "    f_transform = np.fft.fft2(gray)\n",
    "    f_shift = np.fft.fftshift(f_transform)\n",
    "    \n",
    "    if filter_type == 'lowpass':\n",
    "        filter_matrix = butterworth_lowpass_filter(gray.shape, cutoff, order)\n",
    "    else:\n",
    "        filter_matrix = butterworth_highpass_filter(gray.shape, cutoff, order)\n",
    "\n",
    "    f_shift_filtered = f_shift * filter_matrix\n",
    "\n",
    "    f_ishift = np.fft.ifftshift(f_shift_filtered)\n",
    "    img_back = np.fft.ifft2(f_ishift)\n",
    "    img_back = np.abs(img_back)\n",
    "    \n",
    "    img_back = cv2.normalize(img_back, None, 0, 255, cv2.NORM_MINMAX)\n",
    "    filtered_image = np.uint8(img_back)\n",
    "    \n",
    "    return filtered_image, filter_matrix\n",
    "\n",
    "\n",
    "def visualize_butterworth_filter():\n",
    "    \"\"\"\n",
    "    Визуализация фильтров Баттерворта с разными параметрами.\n",
    "    \"\"\"\n",
    "    shape = (512, 512)\n",
    "    cutoff = 50\n",
    "    orders = [1, 2, 4, 8]\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 4, figsize=(20, 10))\n",
    "    \n",
    "    for i, order in enumerate(orders):\n",
    "        lp_filter = butterworth_lowpass_filter(shape, cutoff, order)\n",
    "        axes[0, i].imshow(lp_filter, cmap='gray')\n",
    "        axes[0, i].set_title(f'Lowpass (n={order})')\n",
    "        axes[0, i].axis('off')\n",
    "        \n",
    "        hp_filter = butterworth_highpass_filter(shape, cutoff, order)\n",
    "        axes[1, i].imshow(hp_filter, cmap='gray')\n",
    "        axes[1, i].set_title(f'Highpass (n={order})')\n",
    "        axes[1, i].axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "def compare_butterworth_filters(image):\n",
    "    \"\"\"\n",
    "    Сравнение низкочастотной и высокочастотной фильтрации Баттерворта.\n",
    "    \"\"\"\n",
    "    if len(image.shape) == 3:\n",
    "        gray = cv2.cvtColor(image, cv2.COLOR_BGR2GRAY)\n",
    "    else:\n",
    "        gray = image.copy()\n",
    "    \n",
    "    cutoff = 50\n",
    "    order = 2\n",
    "\n",
    "    lp_filtered, lp_filter = apply_butterworth_filter(image, cutoff, order, 'lowpass')\n",
    "    hp_filtered, hp_filter = apply_butterworth_filter(image, cutoff, order, 'highpass')\n",
    "    \n",
    "    fig, axes = plt.subplots(2, 3, figsize=(15, 10))\n",
    "    \n",
    "    axes[0, 0].imshow(gray, cmap='gray')\n",
    "    axes[0, 0].set_title('Original Image')\n",
    "    axes[0, 0].axis('off')\n",
    "   \n",
    "    axes[0, 1].imshow(lp_filter, cmap='gray')\n",
    "    axes[0, 1].set_title(f'Butterworth Lowpass\\n(cutoff={cutoff}, order={order})')\n",
    "    axes[0, 1].axis('off')\n",
    "\n",
    "    axes[0, 2].imshow(lp_filtered, cmap='gray')\n",
    "    axes[0, 2].set_title('Lowpass Result')\n",
    "    axes[0, 2].axis('off')\n",
    "    \n",
    "    f_transform = np.fft.fft2(gray)\n",
    "    f_shift = np.fft.fftshift(f_transform)\n",
    "    magnitude_spectrum = 20 * np.log(np.abs(f_shift) + 1)\n",
    "    axes[1, 0].imshow(magnitude_spectrum, cmap='gray')\n",
    "    axes[1, 0].set_title('Magnitude Spectrum')\n",
    "    axes[1, 0].axis('off')\n",
    "    \n",
    "    axes[1, 1].imshow(hp_filter, cmap='gray')\n",
    "    axes[1, 1].set_title(f'Butterworth Highpass\\n(cutoff={cutoff}, order={order})')\n",
    "    axes[1, 1].axis('off')\n",
    "    \n",
    "    axes[1, 2].imshow(hp_filtered, cmap='gray')\n",
    "    axes[1, 2].set_title('Highpass Result')\n",
    "    axes[1, 2].axis('off')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return lp_filtered, hp_filtered"
   ]
